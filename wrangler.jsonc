{
  "name": "seo-geo-check",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [ { "name": "AUDIT_GATE", "class_name": "AuditGate" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["AuditGate"] } ],
  "ratelimits": [
    { "name": "RL_START", "namespace_id": "7101", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_FETCH", "namespace_id": "7102", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": { "TURNSTILE_SITEKEY": "1x00000000000000000000AA", "CONTACT_URL": "https://lin.ee/8xXGMUU", "AUDIT_ENABLED": "true", "DAILY_AUDIT_CAP": "1000", "SELF_HOSTS": "" },
  "observability": { "enabled": false }
}
